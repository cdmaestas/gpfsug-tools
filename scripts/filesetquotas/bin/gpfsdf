#!/usr/bin/python3
import subprocess  # nosec B404  # argv is always a fixed literal list; no shell, no untrusted input
import sys

# Collect per-fileset usage from mmrepquota and per-fileset paths from
# mmlsfileset for the NOC filesystem, then print a combined quota summary.


def gpfs_lines(argv, skip):
    """Run a GPFS command and return its stdout lines past the header rows.

    Runs the command directly (no shell, so no command-injection surface) and
    captures stdout in-process (no predictable /tmp file to race or hijack).
    check=True makes a failed command raise loudly instead of leaving the old
    code to parse an empty temp file and print a silent, empty table.
    """
    result = subprocess.run(  # nosec B603  # fixed argv, no shell, no untrusted input
        argv, capture_output=True, text=True, check=True
    )
    return result.stdout.splitlines()[skip:]


# Split into fields, skipping any blank line (e.g. a trailing newline)
lines = gpfs_lines(["/usr/lpp/mmfs/bin/mmrepquota", "-j", "NOC"], skip=2)
fsettable = [line.split() for line in lines if line.strip()]
# Make a database out of it
fsetDict = {}
# Populate the database, checking for duplicate paths
for x in fsettable:
    if len(x) <= 8:
        raise ValueError(f"Unexpected mmrepquota line (need >=9 fields): {x}")
    if x[0] in fsetDict:
        print("Duplicate path: " + x[0])
        break
    fsetDict[x[0]] = [x[2], x[3], x[4], x[5], x[8]]
#  fileset   Used   quota  limit  in_doubt  Number_of_files
lines = gpfs_lines(["/usr/lpp/mmfs/bin/mmlsfileset", "NOC"], skip=3)
table = [line.split() for line in lines if line.strip()]
# Make a database out of it
pathDict = {}
for x in table:
    if len(x) <= 2:
        raise ValueError(f"Unexpected mmlsfileset line (need >=3 fields): {x}")
    if x[0] in pathDict:
        print("Duplicate ID" + pathDict[x[0]])
        sys.exit()
    pathDict[x[0]] = x[2]

# Print out the headers
print()
print(f"{'Path':<39}{'Fileset':<26}{'Quota(Gb)':>10}{'Used(Gb)':>10}{'Files':>10}")
print()

# For all of the filesets in the list
total = 0
totalf = 0
totalQ = 0
for fileset in sorted(pathDict, key=str.lower):
    # Pull out the path from the entry
    thispath = pathDict[fileset]
    if fileset in fsetDict:
        quota = int(fsetDict[fileset][1]) // 1024 // 1024
        used = float(fsetDict[fileset][0]) / 1024 / 1024
        files = int(fsetDict[fileset][4])
        print(f"/noc{str(thispath)[9:]:<35}{fileset:<26}{quota:>8}{used:12.3f}{files:>10}")
        total = total + used
        totalf = totalf + files
        totalQ = totalQ + quota
print()
print(f"{'Total':<68}{totalQ:<4}{total:12.3f} {totalf:>9}")
print()

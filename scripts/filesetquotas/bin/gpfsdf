#!/usr/bin/python3
import os
import sys
import time

# Collect per-fileset usage from mmrepquota and per-fileset paths from
# mmlsfileset for the NOC filesystem, then print a combined quota summary.

ioutfile = '/tmp/' + str(time.time())
cmd = '/usr/lpp/mmfs/bin/mmrepquota -j NOC > ' + ioutfile
os.system(cmd)

f = open(ioutfile)
f.readline()
f.readline()
lines = f.readlines()
f.close()
cmd = 'rm -f ' + ioutfile
os.system(cmd)
# Split it into lines
fsettable = [line.split() for line in lines]
# Make a database out of it
fsetDict = {}
# Populate the database, checking for duplicate paths
for x in fsettable:
    if x[0] in fsetDict:
        print('Duplicate path: ' + x[0])
        break
    fsetDict[x[0]] = [x[2], x[3], x[4], x[5], x[8]]
#  fileset   Used   quota  limit  in_doubt  Number_of_files
cmd = '/usr/lpp/mmfs/bin/mmlsfileset NOC > ' + ioutfile
os.system(cmd)
f = open(ioutfile)
f.readline()
f.readline()
f.readline()
lines = f.readlines()
f.close()
cmd = 'rm -f ' + ioutfile
os.system(cmd)
# Split it into lines
table = [line.split() for line in lines]
# Make a database out of it
pathDict = {}
for x in table:
    if x[0] in pathDict:
        print('Duplicate ID' + pathDict[x[0]])
        sys.exit()
    pathDict[x[0]] = x[2]

# Print out the headers
print()
print(f"{'Path':<39}{'Fileset':<26}{'Quota(Gb)':>10}{'Used(Gb)':>10}{'Files':>10}")
print()

# For all of the filesets in the list
total = 0
totalf = 0
totalQ = 0
for fileset in sorted(pathDict, key=str.lower):
    # Pull out the path from the entry
    thispath = pathDict[fileset]
    if fileset in fsetDict:
        quota = int(fsetDict[fileset][1]) // 1024 // 1024
        used = float(fsetDict[fileset][0]) / 1024 / 1024
        files = int(fsetDict[fileset][4])
        print(f"/noc{str(thispath)[9:]:<35}{fileset:<26}{quota:>8}{used:12.3f}{files:>10}")
        total = total + used
        totalf = totalf + files
        totalQ = totalQ + quota
print()
print(f"{'Total':<68}{totalQ:<4}{total:12.3f} {totalf:>9}")
print()

#! /bin/bash

set -euo pipefail

readonly CONFIG="mmlsconfig.wien"

if [ -z "${1:-}" ]; then
  echo
  echo "$0 <nodeclass>"
  exit 2
fi

NODECLASS=$1

PRINT=false
NOT_ENDED=true

# Read the config line by line rather than word-splitting `cat` output: this
# avoids glob expansion of lines and fails loudly (via set -e) if the file is
# missing, instead of silently iterating over nothing.
while IFS= read -r line || [ -n "$line" ]; do
  if [[ $line =~ "File systems in cluster" ]]; then
    PRINT=false
    NOT_ENDED=false
  fi

  if [[ $line =~ \[ ]]; then                       ## Section Header
    if [[ $line =~ (\[|,)$NODECLASS(\]|,) ]]; then ## that matches
      #echo "Section match: $line"
      PRINT=true
    else
      # echo "Section no match: $line"
      PRINT=false
    fi
  else ## Normal line
    if $PRINT && $NOT_ENDED; then
      echo "$line"
    fi
  fi

done <"$CONFIG" | sort -f

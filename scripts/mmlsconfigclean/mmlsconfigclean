#! /bin/bash

set -euo pipefail

readonly CONFIG="mmlsconfig.wien"

# Extract the distinct node-class names from the section headers and list the
# config for each. `sort -u` replaces `sort | uniq`; dropping the leading `cat`
# removes a useless use of cat.
# shellcheck disable=SC2013  # node-class names are single tokens; word-splitting is intended.
for NODECLASS in $( grep '\[' "$CONFIG" | sed 's/\[\|\]//g' | sed 's/,/\n/g' | sort -u ) ; do
  echo
  echo "[$NODECLASS]"
  ./mmlsconfigpernodeclass "$NODECLASS"
done
